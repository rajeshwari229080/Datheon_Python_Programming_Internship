# =================================================================
# CodeCraft Python Studio - Comprehensive .gitignore
# =================================================================

# Python Bytecode & Compilation Caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Environments & Dependencies
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs & Developer Tooling
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Scratch Files & Temporary Logs
*.log
scratch/
tmp/
*.tmp
